# Copy file này thành .env và điền giá trị thật. KHÔNG commit file .env.

MONGO_URI=
MONGO_DB_NAME=
PORT=8000

# Múi giờ của backend (mặc định Asia/Ho_Chi_Minh). Dùng APP_TZ vì Vercel không cho đặt TZ;
# src/config/timezone.js sẽ gán process.env.TZ lúc khởi động.
APP_TZ=Asia/Ho_Chi_Minh

# Chuỗi ngẫu nhiên dài (vd: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=
TOKEN_EXPIRE=1d

# Mailer
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=

# VNPay
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=
# Trỏ về BACKEND (vd: https://<backend>/api/payments/vnpay-return): backend chỉ kiểm tra chữ ký
# rồi chuyển trình duyệt về FRONTEND_URL/dashboard/invoices/<id>?payment=success|failed
VNPAY_RETURN_URL=
# https://<backend>/api/payments/vnpay-ipn — phải đăng ký URL này với VNPay (cấu hình merchant);
# chỉ IPN mới ghi nhận thanh toán vào hệ thống
VNPAY_IPN_URL=
FRONTEND_URL=

# URL công khai của backend (dùng cho link xác nhận quên mật khẩu trong email)
# vd: https://clinic-manager-system-backend.vercel.app
BACKEND_PUBLIC_URL=
