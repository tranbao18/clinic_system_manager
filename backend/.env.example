# Copy file này thành .env và điền giá trị thật. KHÔNG commit file .env.

MONGO_URI=
MONGO_DB_NAME=
PORT=8000

# Chuỗi ngẫu nhiên dài (vd: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=
TOKEN_EXPIRE=1d

# Mailer
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=

# VNPay
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=
VNPAY_RETURN_URL=
VNPAY_IPN_URL=
FRONTEND_URL=
